<%- include('../../partials/siteHeader', {pageTitle: pageTitle}) %>

<section class="container">
    <div class="row">
        <div class="col-md-4 mb-3">
            <img src="<%= movie.thumbnail || '/img/logo.png' %>" class="img-fluid rounded shadow-sm"
                alt="<%= movie.title %>" onerror="this.onerror=null;this.src='/img/logo.png';">
        </div>
        <div class="col-md-8">
            <h1><%= movie.title %></h1>
            <h4 class="text-muted"><%= movie.year %></h4>

            <p>
                <strong>Genres:</strong>
                <% if (movie.genres && movie.genres.length > 0) { %>
                    <% movie.genres.forEach(function(g) { %>
                        <span class="badge bg-secondary"><%= g %></span>
                    <% }); %>
                <% } else { %> - <% } %>
            </p>

            <p>
                <strong>Cast:</strong>
                <%= (movie.cast && movie.cast.length > 0) ? movie.cast.join(', ') : '-' %>
            </p>

            <a href="/movies" class="btn btn-outline-dark">Back</a>
            <a href="/movies/updateForm/<%= movie._id %>" class="btn btn-secondary">Edit</a>
            <form action="/movies/destroy/<%= movie._id %>" method="POST" class="d-inline"
                onsubmit="return confirm('Are you sure you want to delete this movie?');">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>
        </div>
    </div>
</section>

<%- include('../../partials/siteFooter') %>
